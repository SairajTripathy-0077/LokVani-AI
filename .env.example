# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration
# Local MongoDB connection string or MongoDB Atlas cloud URI
MONGODB_URI=mongodb://localhost:27017/lokvani_ai

# Clerk Authentication (BaaS)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# Google Gemini AI API Keys (Key Rotator Engine)
# Provide comma-separated API keys for automatic round-robin rotation and failover
GEMINI_API_KEYS=AIzaSyPlaceholderKey1,AIzaSyPlaceholderKey2,AIzaSyPlaceholderKey3
VITE_GEMINI_API_KEY=AIzaSyPlaceholderKey1

# Grievance / Complaint Email (Scheme Application Tracker)
# Uses EmailJS REST API — no SMTP server required.
# 1. Create a free account at https://www.emailjs.com/
# 2. Add an email service → note the SERVICE ID (service_xxxxxxx)
# 3. Create a template using these params: {{to_email}}, {{cc_email}}, {{subject}}, {{message}}
#    → note the TEMPLATE ID (template_xxxxxxx)
# 4. Copy your Public Key (and Private Key for server-side REST calls)
# If left empty, complaints are still logged but no email is delivered.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
GRIEVANCE_FALLBACK_EMAIL=grievances@lokvani-demo.in

# TESTING BYPASS: unlock the Complain button immediately (skips SLA + cooldown)
ALLOW_EARLY_COMPLAINT=false
VITE_ALLOW_EARLY_COMPLAINT=false

# ─────────────────────────────────────────────────────────────────────────────
# COMMUNITY INTEL — GOVERNMENT DATA APIs
# Paste the key you get from each website below. If left blank, the app
# automatically falls back to realistic demo data — nothing will break.
# ─────────────────────────────────────────────────────────────────────────────

# 1. data.gov.in — Mandi Prices (Today's Crop Prices + Compare Markets)
#    Register at: https://data.gov.in/user/register
#    Then go to:  https://data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070#api
#    Click "Show API" tab → copy the key and paste it here
VITE_DATA_GOV_API_KEY=

# 2. eNAM — Buyers Near You (Registered Trader / FPO Directory)
#    Register at: https://enam.gov.in/web/
#    OR paste the same data.gov.in key here — it uses that as fallback
VITE_ENAM_API_KEY=

# 3. NWR / data.gov.in — Transport & Storage (Warehouse Capacity)
#    No separate key needed — reuses VITE_DATA_GOV_API_KEY automatically
#    Dataset: https://data.gov.in/catalog/warehousing-storage-facilities
#    (Leave blank — handled automatically)
VITE_NWR_API_KEY=

# 4. GNews — Live Agriculture News (Community Intel Feed)
#    Register at: https://gnews.io/
#    Required to show live regional news instead of demo data.
VITE_GNEWS_API_KEY=
