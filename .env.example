PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lokvani_ai

# Google Gemini AI API Keys
GEMINI_API_KEYS=AIzaSyPlaceholderKey1,AIzaSyPlaceholderKey2
VITE_GEMINI_API_KEY=AIzaSyPlaceholderKey1

# Firebase Authentication & Analytics Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# TESTING BYPASS
ALLOW_EARLY_COMPLAINT=true
VITE_ALLOW_EARLY_COMPLAINT=true

# EmailJS Configuration
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
GRIEVANCE_FALLBACK_EMAIL=grievances@lokvani-demo.in

# Feature Flags
VITE_ENABLE_DISTRESS=true

# COMMUNITY INTEL — GOVERNMENT DATA APIs
# Paste the key you get from each website below. If left blank, the app
# automatically falls back to realistic demo data — nothing will break.
# ─────────────────────────────────────────────────────────────────────────────

# 1. data.gov.in — Mandi Prices (Today's Crop Prices + Compare Markets)
#    Register at: https://data.gov.in/user/register
#    Then go to:  https://data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070#api
#    Click "Show API" tab → copy the key and paste it here
VITE_DATA_GOV_API_KEY=

# 2. eNAM — Buyers Near You (Registered Trader / FPO Directory)
#    Register at: https://enam.gov.in/web/
#    OR paste the same data.gov.in key here — it uses that as fallback
VITE_ENAM_API_KEY=

# 3. NWR / data.gov.in — Transport & Storage (Warehouse Capacity)
#    No separate key needed — reuses VITE_DATA_GOV_API_KEY automatically
#    Dataset: https://data.gov.in/catalog/warehousing-storage-facilities
#    (Leave blank — handled automatically)
VITE_NWR_API_KEY=

