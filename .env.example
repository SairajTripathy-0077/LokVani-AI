# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration
# Local MongoDB connection string or MongoDB Atlas cloud URI
MONGODB_URI=mongodb://localhost:27017/lokvani_ai

# Clerk Authentication (BaaS)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# Google Gemini AI API Keys (Key Rotator Engine)
# Provide comma-separated API keys for automatic round-robin rotation and failover
GEMINI_API_KEYS=AIzaSyPlaceholderKey1,AIzaSyPlaceholderKey2,AIzaSyPlaceholderKey3
VITE_GEMINI_API_KEY=AIzaSyPlaceholderKey1

# Grievance / Complaint Email (Scheme Application Tracker)
# SMTP credentials used by nodemailer to send complaint emails.
# If left empty, complaints are still logged but no email is delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
GRIEVANCE_FALLBACK_EMAIL=grievances@lokvani-demo.in

# TESTING BYPASS: unlock the Complain button immediately (skips SLA + cooldown)
ALLOW_EARLY_COMPLAINT=false
VITE_ALLOW_EARLY_COMPLAINT=false
